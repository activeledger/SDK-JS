{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["es2019", "dom"],
    "target": "es2019",
    "module": "commonjs",
    "alwaysStrict": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    // Do not type check third party .d.ts files. @noble/post-quantum's own
    // declarations import with explicit ".ts" extensions, which this
    // moduleResolution rejects (TS2691) even though the emitted JavaScript is
    // fine and the package works. The alternative - moving the whole repo to
    // node16/bundler resolution - changes how every import in every package
    // resolves, to fix type checking of a dependency we do not maintain.
    "skipLibCheck": true,
    "removeComments": true
  },
  "exclude": ["**/lib/", "**/es/", "**/node_modules/", "**/__tests__/*"]
}
