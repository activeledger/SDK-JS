{
  "name": "activeledger-sdk-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/node && npm run build -w packages/web",
    "test": "npm run build && jest --config=jestconfig.json && npm run test -w packages/web && node scripts/verify-pq-interop.mjs && node scripts/verify-ledger-interop.mjs && node scripts/verify-vectors.mjs && node scripts/verify-seed-vectors.mjs && node scripts/verify-seed-guard.mjs && node scripts/verify-number-vectors.mjs",
    "vectors": "node scripts/pq-vectors.mjs",
    "verify:ledger": "node scripts/verify-ledger-interop.mjs",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "docs": "typedoc --out ./docs --readme ./Readme.md packages/*/src/index.ts",
    "vectors:seed": "node scripts/seed-vectors.mjs",
    "vectors:numbers": "node scripts/number-vectors.mjs"
  },
  "homepage": "https://github.com/activeledger/SDK-JS",
  "keywords": [
    "activeledger",
    "sdk",
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "react-native",
    "browser",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/SDK-JS.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/SDK-JS/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "29.4.0",
    "@types/node": "^20.14.0",
    "jest": "29.4.3",
    "lerna": "^8.1.2",
    "prettier": "2.8.4",
    "ts-jest": "29.0.5",
    "typedoc": "^0.25.13",
    "typescript": "4.9.5"
  },
  "version": "2.5.1"
}
