{
  "name": "activeledger-sdk-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/node && npm run build -w packages/web",
    "test": "npm run build && jest --config=jestconfig.json",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "docs": "typedoc --out ./docs --readme ./Readme.md packages/*/src/index.ts"
  },
  "homepage": "https://activeledger.io",
  "keywords": [
    "activeledger",
    "sdk",
    "blockchain",
    "dlt",
    "distributed ledger technology",
    "ledger",
    "smart contracts",
    "react-native",
    "browser",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeledger/SDK-NodeJS.git"
  },
  "bugs": {
    "url": "https://github.com/activeledger/SDK-NodeJS/issues"
  },
  "author": "Activeledger",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "29.4.0",
    "@types/node": "^20.14.0",
    "jest": "29.4.3",
    "lerna": "^8.1.2",
    "prettier": "2.8.4",
    "ts-jest": "29.0.5",
    "typedoc": "^0.25.13",
    "typescript": "4.9.5"
  }
}
